{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radius dataset manifest (EP-03)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "kind", "source", "license", "redistribution", "status", "accessed", "rqs", "labels", "risks", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "name": { "type": "string" },
    "kind": { "enum": ["benchmark", "label-source", "pr-corpus", "fixture", "trajectories", "paper-only"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "revision"],
      "properties": {
        "type": { "enum": ["huggingface", "github", "zenodo", "arxiv", "local", "none"] },
        "url": { "type": "string" },
        "revision": { "type": "string" },
        "revision_kind": { "enum": ["commit", "tag", "doi", "version", "none", "UNVERIFIED"] },
        "doi": { "type": "string" },
        "paper": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "verdict", "evidence"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "spdx": { "type": "string" },
        "verdict": { "enum": ["open", "restricted", "unknown", "internal"] },
        "evidence": { "type": "string" }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": { "enum": ["yes", "no", "conditional"] },
        "notes": { "type": "string" }
      }
    },
    "status": { "enum": ["available", "requested", "blocked"] },
    "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "size": { "type": "string" },
    "rqs": { "type": "array", "items": { "type": "string" } },
    "labels": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "obtain": { "type": "string" },
    "notes": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
