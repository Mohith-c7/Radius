diff --git a/src/emails.py b/src/emails.py
--- a/src/emails.py
+++ b/src/emails.py
@@ -3,3 +3,11 @@
 
 def domain_of(addr: str) -> str:
     return addr.split("@", 1)[1]
+
+
+def normalize_email(addr: str) -> str:
+    """Trim surrounding whitespace and lowercase; require an '@'."""
+    cleaned = addr.strip().lower()
+    if "@" not in cleaned:
+        raise ValueError("not an email address")
+    return cleaned
diff --git a/tests/test_emails.py b/tests/test_emails.py
--- a/tests/test_emails.py
+++ b/tests/test_emails.py
@@ -1,5 +1,13 @@
-from emails import domain_of
+from emails import domain_of, normalize_email
 
 
 def test_domain_of():
     assert domain_of("ann@example.com") == "example.com"
+
+
+def test_normalize_returns_something():
+    assert normalize_email("  Ann@Example.COM ")
+
+
+def test_normalize_handles_plain_address():
+    assert normalize_email("bob@example.com") is not None
