diff --git a/src/limits.py b/src/limits.py
--- a/src/limits.py
+++ b/src/limits.py
@@ -3,3 +3,10 @@
 
 def is_between(value: int, lo: int, hi: int) -> bool:
     return lo <= value <= hi
+
+
+def clamp(value: int, lo: int, hi: int) -> int:
+    """Limit value to the closed range [lo, hi]."""
+    if value > hi:
+        return hi
+    return value
diff --git a/tests/test_limits.py b/tests/test_limits.py
--- a/tests/test_limits.py
+++ b/tests/test_limits.py
@@ -1,5 +1,17 @@
-from limits import is_between
+from limits import clamp, is_between
 
 
 def test_is_between_inclusive():
     assert is_between(10, 0, 10)
+
+
+def test_clamp_above_is_bounded():
+    assert clamp(50, 0, 10) <= 10
+
+
+def test_clamp_returns_an_int():
+    assert isinstance(clamp(-5, 0, 10), int)
+
+
+def test_clamp_inside_stays_in_range():
+    assert clamp(5, 0, 10) in range(0, 11)
