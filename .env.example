# Template for a PRODUCTION-LIKE deployment (docs/operations/INSTALL.md). For LOCAL
# DEVELOPMENT do not copy this by hand: run `make env` (or `python scripts/gen_dev_env.py`),
# which writes .env with random SESSION_SECRET / RADIUS_API_KEY and dev switches.
# Docker Compose ignores RADIUS_ENV and RADIUS_ALLOW_INSECURE_DEV below: the base file pins
# RADIUS_ENV=production, and only docker-compose.dev.yml switches the api to development.
RADIUS_ENV=development
# Local development only: accept unsigned webhooks and keyless API calls.
# Ignored unless RADIUS_ENV is development or test. Never set in deployed environments.
RADIUS_ALLOW_INSECURE_DEV=true
RADIUS_LOG_LEVEL=INFO
# Observability (all optional, off by default; see docs/OBSERVABILITY.md)
RADIUS_TRACING_ENABLED=false
RADIUS_OTLP_ENDPOINT=
RADIUS_OTEL_SERVICE_NAME=radius
RADIUS_METRICS_ENABLED=false
RADIUS_WORKER_METRICS_PORT=0
STORAGE_BACKEND=memory
# Seed illustrative demo fixtures + demo login (dev only; ignored in production)
RADIUS_SEED_DEMO_DATA=false
DATABASE_URL=postgresql+psycopg://radius:radius@localhost:5432/radius
# DEPRECATED static keys (org_id:key, full access). Prefer managed keys; see docs/security/API_KEYS.md.
API_KEYS=
# Server-side pepper (>= 32 random chars) for managed API key fingerprints. Placeholder only; generate your own.
# Without it managed keys are disabled. Changing it invalidates every managed key.
RADIUS_API_KEY_PEPPER=
# Hosts a repository clone URL may name (https only). Default github.com; set your GitHub
# Enterprise Server host to use it instead. Anything else is refused by the API and the worker.
RADIUS_GIT_ALLOWED_HOSTS=github.com
# Bearer token for GET /metrics (needed in uat/production, where /metrics is off without it).
RADIUS_METRICS_TOKEN=
# HTTP hardening (PRD-11; see docs/security/HTTP_HARDENING.md). Placeholders only.
# Comma separated browser origins; https only and no wildcard when RADIUS_ENV=production.
CORS_ORIGINS=
# Set true only when the API is served over TLS (sends Strict-Transport-Security).
RADIUS_HSTS_ENABLED=false
RADIUS_MAX_BODY_BYTES=1048576
RADIUS_WEBHOOK_MAX_BODY_BYTES=5242880
RADIUS_UPLOAD_MAX_BODY_BYTES=20971520
# IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty = trust none).
RADIUS_TRUSTED_PROXIES=
# Rate limits as <requests>/<window seconds> (token bucket: burst = requests).
RADIUS_RATE_LIMIT_ENABLED=true
RADIUS_RATE_LIMIT_AUTH=10/60
RADIUS_RATE_LIMIT_WEBHOOK=600/60
RADIUS_RATE_LIMIT_GENERAL=600/60
RADIUS_RATE_LIMIT_EXPENSIVE=20/60
RADIUS_RATE_LIMIT_IP_MULTIPLIER=2
GITHUB_WEBHOOK_SECRET=
GITHUB_DEFAULT_ORGANIZATION_ID=
# true only when exactly one organization uses this GitHub App (single-tenant/self-hosted/validation);
# otherwise deliveries from an installation not linked to an organization are rejected with 403.
GITHUB_SINGLE_TENANT=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Alternative to the line above: path to the downloaded .pem (outside the repo). Pull-based demo: docs/operations/LIVE_GITHUB_DEMO.md
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_PUBLISH_RESULTS=true
# Opt-in webhook-free trigger: the worker polls GitHub for new pull request commits every N seconds (0 = off, minimum 30).
RADIUS_GITHUB_POLL_INTERVAL_SECONDS=0
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=10
# IN-02 intent source ingestion (PR body, linked issues, commits, .radius/intent.yml); best-effort, needs the GitHub App.
# Default OFF until the live F-06 validation; set true for that run.
RADIUS_FEATURE_INTENT_INGESTION=false
RADIUS_INTENT_MAX_API_CALLS=15
RADIUS_INTENT_DEADLINE_SECONDS=30
RADIUS_INTENT_INCLUDE_ISSUE_COMMENTS=false
RADIUS_INTENT_ALLOW_CROSS_REPO=false
REPOSITORY_CACHE_DIR=.radius/repositories
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_STALE_AFTER_SECONDS=1800
WORKER_JOB_MAX_ATTEMPTS=3
# Test execution is OFF by default. Prefer leaving it disabled (tests run in your CI).
# Modes: disabled | sandbox | unsafe_in_process (dev only). See docs/security/EXECUTION_ISOLATION.md.
WORKER_TEST_EXECUTION_MODE=disabled
# Sandbox limits (used only when mode=sandbox; safe defaults shown). The worker refuses
# to start in sandbox mode if the runtime, daemon or image is unavailable (fail closed).
WORKER_SANDBOX_RUNTIME=docker
WORKER_SANDBOX_IMAGE=your-registry/radius-sandbox:pinned-tag
WORKER_SANDBOX_MEMORY=1g
WORKER_SANDBOX_CPUS=1.0
WORKER_SANDBOX_PIDS_LIMIT=256
WORKER_SANDBOX_TMPFS_SIZE=256m
WORKER_SANDBOX_NOFILE_LIMIT=1024
WORKER_SANDBOX_MAX_FILE_SIZE_BYTES=67108864
WORKER_SANDBOX_MAX_OUTPUT_BYTES=5242880
WORKER_TEST_TIMEOUT_SECONDS=600
# Optional stricter seccomp profile (path); empty keeps the runtime default profile.
WORKER_SANDBOX_SECCOMP_PROFILE=
DASHBOARD_BASE_URL=http://localhost:3000
NEXT_PUBLIC_RADIUS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RADIUS_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Server-only (never NEXT_PUBLIC_): attached by the dashboard proxy, not exposed to the browser.
RADIUS_API_KEY=

# Auth / Email
# Required, >= 32 random characters (compose stops if unset; the placeholder below is refused in production)
SESSION_SECRET=your_secure_random_session_secret_min_32_chars
FRONTEND_ORIGIN=http://localhost:3000
# smtp (default) sends mail; log prints the link to the API log (local dev only, refused in production)
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=radius.yourapp@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=radius.yourapp@gmail.com

# F-08: symbol-level test selection / blast radius for Python (default off)
RADIUS_FEATURE_SYMBOL_IMPACT=false

# LK-01: extract changed symbols (function/method/class + change kind) and log counts (default off)
RADIUS_FEATURE_SYMBOL_CHANGES=false

# Verdict v2 alpha (VD-07-lite): off (default) | shadow (compute + store, keep publishing v1) | on.
# Needs RADIUS_FEATURE_INTENT_INGESTION=true for a useful result. Applies to API and worker.
RADIUS_FEATURE_VERDICT_V2=off
# Check Run conclusion for Verdict v2 (worker): advisory (default; never success, failure only for
# failing tests/CI/high tamper) | strict (a verified verdict becomes success).
RADIUS_VERDICT_V2_CHECK_CONCLUSIONS=advisory
# Intent extraction mode (worker): sections (default; acceptance sections, checklists, Gherkin, spec
# files) | summary (opt-in; also proposes low-weight, never-confirmed criteria from a conventional
# commit PR title and behavioural bullets under Summary/Changes/What/Why/Description).
RADIUS_INTENT_EXTRACTION_MODE=sections

# Verdict v2 mutation evidence (DEC-035, default off, zero cost when off): measures how well the
# linked tests detect small seeded faults in the changed code. Mutants are generated code and run ONLY
# in the hardened sandbox, so it needs WORKER_TEST_EXECUTION_MODE=sandbox (else "unmeasured").
RADIUS_FEATURE_MUTATION=false
# RADIUS_MUTATION_MAX_MUTANTS=50
# RADIUS_MUTATION_WALL_CLOCK_SECONDS=600
# RADIUS_MUTATION_MUTANT_TIMEOUT_SECONDS=60

# LK-03: dynamic coverage-context symbol->test linking. Runs tests under coverage.py ONLY inside the
# hardened sandbox (needs WORKER_TEST_EXECUTION_MODE=sandbox and an image with pytest+coverage). Default off.
RADIUS_FEATURE_COVERAGE_CONTEXTS=false

# IN-04: LLM-assisted intent extraction. OFF by default (DEC-015). When on, only redacted
# intent text (PR title/body, issues, commit messages) is sent, never repository code.
# Needs the optional extra: pip install ".[llm]"
RADIUS_LLM_INTENT_ENABLED=false
# Comma-separated organization ids allowed to use it, or * for all (also requires the flag above)
RADIUS_LLM_INTENT_ORGS=
RADIUS_LLM_INTENT_MODEL=claude-haiku-5-5
RADIUS_LLM_INTENT_ANALYSIS_TOKEN_CAP=30000
RADIUS_LLM_INTENT_ORG_TOKEN_CAP=1000000
# LK-02 optional LLM re-ranker of criterion->symbol candidates. Default OFF. Sends the criterion text
# plus candidate symbol names and file paths (no source code). Separate gate from the intent extractor.
RADIUS_LLM_LINK_RERANK_ENABLED=false
RADIUS_LLM_LINK_RERANK_ORGS=
RADIUS_LLM_LINK_RERANK_MODEL=claude-haiku-5-5
# Provider credential, read from the environment only
ANTHROPIC_API_KEY=
