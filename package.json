{
  "name": "radius",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native software verification platform.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "db:migrate": "alembic upgrade head",
    "db:revision": "alembic revision --autogenerate",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
